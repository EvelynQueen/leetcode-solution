var removeKdigits = function (num, k) {
  const stack = [];

  for (const d of num) {
    while (k && stack.length && stack[stack.length - 1] > d) {
      stack.pop();
      k--;
    }
    stack.push(d);
  }

  while (k--) stack.pop();

  let res = stack.join("").replace(/^0+/, "");
  return res === "" ? "0" : res;
};
