
// Using 2 Flags to keep track
// 1. Both flag is true at first
// 2. If val1 > val 2 => non_decreae => decrease = false & increase = true => increasing || decreasing = true
// 3. If val1 < val 2 => non_increae => increase = false & decrease = true => increasing || decreasing = true
// If val1 > val2 && val2 < val3 => decrease = false  & decrease = false => increasing || decreasing = false


var isMonotonic = function (nums) {
    let increasing = true;
    let decreasing = true;

    for (let i = 1; i < nums.length; i++) {
        if (nums[i] < nums[i - 1]) increasing = false;
        if (nums[i] > nums[i - 1]) decreasing = false;
    }

    return increasing || decreasing;

};
