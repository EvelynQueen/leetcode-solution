///Using index queue (keep reference to k)
// Each time : tickets[headOfQueue]--
// if tickets[headOfQueue] === 0 && headOfQueue = k => return time
// Else if if tickets[headOfQueue] === 0 && headOfQueue !== k => headOfQueue out of queue
// Else headOfQueue != k => push heaadOfQueue to tail of queue

var timeRequiredToBuy = function (tickets, k) {
  let queue = [];
  let time = 0;

  for (let i = 0; i < tickets.length; i++) {
    queue.push(i);
  }

  while (true) {
    let idx = queue.shift();
    tickets[idx]--;
    time++;

    if (tickets[idx] === 0) {
      if (idx === k) return time;
    } else {
      queue.push(idx);
    }
  }
};


//Counting maximum tickets that a people can buy => time
// Whenever people at k can buy all tickets needed
// We stop the queue
// => All people (i) <= k can buy at most tickets[k]
//  => All people (i) > k can buy at most tickets[k] - 1 
// So most of the tickets that people in queue can buy = times k needed to buy tickets[k];

var timeRequiredToBuy = function (tickets, k) {
  let time = 0;
  let cur = tickets[k];

  for (let i = 0; i < tickets.length; i++) {
    if (i <= k) {
      time += Math.min(tickets[i], cur);
    } else {
      time += Math.min(tickets[i], cur - 1);
    }
  }

  return time;
};

