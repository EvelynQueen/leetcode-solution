// Using hashmap
// Harmonious array as an array where the difference between its maximum value and its minimum value is exactly 1
// => max - min = 1 and array is full of integer => harmonious array = [max, min, min, max, min]
// => count frequency of {min : freq} and {min + 1 : freq} (min + 1 = max)
// sum of min and max frequencies = length of Harmonious array

var findLHS = function (nums) {
    let freqMap = new Map();
    let longestSub = 0;
    for (let num of nums) {
        freqMap.set(num, (freqMap.get(num) || 0) + 1);
    }

    for (let [key, val] of freqMap) {
        if (freqMap.has(key + 1)) {
            longestSub = Math.max(
                longestSub,
                val + freqMap.get(key + 1)
            );
        }
    }
    return longestSub

};

// Using sliding window
// Same logic for harmonious array
// However, we sorted the given array
// Then we sliding the window through the array 

var findLHS = function (nums) {
  nums.sort((a, b) => a - b);

  let left = 0;
  let longest = 0;

  for (let right = 0; right < nums.length; right++) {
    while (nums[right] - nums[left] > 1) {
      left++;
    }

    if (nums[right] - nums[left] === 1) {
      longest = Math.max(longest, right - left + 1);
    }
  }

  return longest;
};
