
//1. Using sort() methods for t and s, then compare each character in s and t
// The only character in t that's different from s is the added character

var findTheDifference = function (s, t) {
  t = t.split("").sort();
  s = s.split("").sort();
  for (let i = 0; i <= t.length - 1; i++) {
    if (t[i] !== s[i]) {
      return t[i];
    }
  }
};

//2. Using HashMap to count frequency of each character in s and t

//Using 2 maps;
// Compare the frequency of each character of s and t
// The character in t that has a different frequency from the corresponding character in s is the extra character
// Or the character that's appeare in t but not appear in s is also the extra character 

var findTheDifference = function (s, t) {
  let sourceCharCount = new Map();
  let targetCharCount = new Map();

  for (let index = 0; index < s.length; index++) {
    sourceCharCount.set(s[index], (sourceCharCount.get(s[index]) || 0) + 1);
  }

  for (let index = 0; index < t.length; index++) {
    targetCharCount.set(t[index], (targetCharCount.get(t[index]) || 0) + 1);
  }

  for (let [char, count] of targetCharCount) {
    if ((sourceCharCount.get(char) || 0) !== count) {
      return char;
    }
  }
};


// Using 1 map;
// All characters in s and t are keys, the initial value of each key is 0
// If a character in s is found, increase the value of that key by 1
// If a character in t is found, decrease the value of that key by 1
// because every character in s also appears in t, the values of those keys become 0
// there is exactly 1 extra character in t that does not appear in s, so the value of that key becomes -1
// Iterate over [key, value] in the map, if any value is not equal to 0,
// the character corresponding to that key is the added character !!!

var findTheDifference = function (s, t) {
  let charCount = new Map();

  for (let index = 0; index < t.length; index++) {
    if (s[index] !== undefined) {
      charCount.set(s[index], (charCount.get(s[index]) || 0) - 1);
    }

    charCount.set(t[index], (charCount.get(t[index]) || 0) + 1);
  }

  for (let [char, count] of charCount) {
    if (count !== 0) {
      return char;
    }
  }
};



// 3. Using sum variable + ASCII charCode
// Using the numeric ASCII value of each character
// t contains every character in s with an extra char
// If we subtract the ASCII values of s
// Then add the ASCII values of t
//All matching characters cancel out
//The remaining value corresponds to the extra character

var findTheDifference = function (s, t) {
  let sum = 0;

  for (let c of s) sum -= c.charCodeAt(0);
  for (let c of t) sum += c.charCodeAt(0);

  return String.fromCharCode(sum);
};


//4 . Using XOR operation
// Rules : a^a = 0 and 0 ^b = b
// t contains every character in s with an extra char
// => that means every char in s xor with t = 0 
// => then we have 0 ^ extra char in t = extra char in t

var findTheDifference = function(s, t) {
  let xor = 0;

  for (const c of s) xor ^= c.charCodeAt(0);
  for (const c of t) xor ^= c.charCodeAt(0);

  return String.fromCharCode(xor);
};

