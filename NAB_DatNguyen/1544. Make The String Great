// Using stack and the difference between numeric ASCII value of lower case and upper case 
// On ASCII, the subtraction of uppercase letter the corresponding lower case letter is exactly 32
// Continuosly check the letter with the top element of stack
var makeGood = function (s) {
  let charStack = [];

  for (let char of s) {
    const top = charStack[charStack.length - 1];

    if (top && Math.abs(char.charCodeAt(0) - top.charCodeAt(0)) === 32) {
      charStack.pop();
    } else {
      charStack.push(char);
    }
  }

  return charStack.join("");
};

