var makeGood = function (s) {
  let charStack = [];

  for (let i = 0; i < s.length; i++) {
    const top = charStack[charStack.length - 1];

    if (
      top &&
      Math.abs(s[i].charCodeAt(0) - top.charCodeAt(0)) === 32
    ) {
      charStack.pop();
    } else {
      charStack.push(s[i]);
    }
  }

  return charStack.join("");
};
