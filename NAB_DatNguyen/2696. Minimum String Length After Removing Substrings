/**
 * @param {string} s
 * @return {number}
 */
var minLength = function (s) {
    let stack = [];

    for (let c of s) {
        let peek = stack[stack.length - 1];

        if ((c === "B" && peek === "A") || (c === "D" && peek === "C")) {
            stack.pop();
        } else {
            stack.push(c);
        }
    }

    return stack.length;
};
