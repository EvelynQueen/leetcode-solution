var dailyTemperatures = function (temperatures) {
  let stack = [];
  let ans = Array(temperatures.length).fill(0);

  for (let i = 0; i < temperatures.length; i++) {
    while (
      stack.length > 0 &&
      temperatures[i] > temperatures[stack[stack.length - 1]]
    ) {
      let index = stack.pop();
      ans[index] = i - index;
    }
    stack.push(i);
  }

  return ans;
};

