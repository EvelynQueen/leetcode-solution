/**
 * @param {string} s
 * @return {string}
 */
var makeFancyString = function (s) {
  let stack = [];
  let count = 0;

  for (let char of s) {
    if (char == stack[stack.length - 1]) {
      stack.push(char);
      count++;
      if (count == 3) {
        stack.pop();
        count--;
      }
    } else {
      stack.push(char);
      count = 1;
    }
  }

  return stack.join("");
};


/**
 * @param {string} s
 * @return {string}
 */
var makeFancyString = function (s) {
    let ans = "";
    let count = 1;
    let last = s[0];
    ans += last;

    for (let i = 1; i <= s.length - 1; i++) {
        if (s[i] !== last) {
            last = s[i];
            count = 0;
        }
        count++;
        if (count > 2) continue;
        ans += s[i];

    }

    return ans;
};
