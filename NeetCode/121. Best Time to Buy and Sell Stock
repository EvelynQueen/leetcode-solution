/**
 * @param {number[]} prices
 * @return {number}
 */
var maxProfit = function (prices) {
  let buy = prices[0];
  let maxProfit = 0;

  for (let i = 0; i <= prices.length - 1; i++) {
    if (buy > prices[i]) {
      buy = prices[i];
    }

    if (prices[i] - buy > maxProfit) {
      maxProfit = prices[i] - buy;
    }
  }

  return maxProfit;
};
