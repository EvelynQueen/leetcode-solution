/**
 * @param {string} s
 * @return {boolean}
 */
var isValid = function (s) {
  let stack = [];
  let valid = {
    "}": "{",
    "]": "[",
    ")": "(",
  };

  for (let c of s) {
    if (c === "{" || c === "(" || c === "[") {
      stack.push(c);
    } else {
      if (valid[c] === stack[stack.length - 1]) {
        stack.pop();
      } else {
        return false;
      }
    }
  }

  return stack.length == 0 ? true : false;
};
